# Copie este arquivo para .claude/jira.env e preencha com os SEUS dados.
# .claude/jira.env esta no .gitignore - nunca commite o arquivo preenchido.

JIRA_URL=https://SEU-SITE.atlassian.net
JIRA_EMAIL=seu.email@dominio.com

# Gere em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=cole-o-token-aqui

# Projeto padrao usado quando a key nao aparece no branch nem nos commits
JIRA_DEFAULT_PROJECT=OPA
